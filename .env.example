# ─── REQUIRED ────────────────────────────────────────────────────────────────

# Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Threads API credentials (from Meta developer dashboard)
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# ─── TELEGRAM (optional but strongly recommended) ─────────────────────────────
# Without Telegram, the bot auto-publishes on schedule without human review.

# Your Telegram bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Your Telegram user ID (get it from @userinfobot)
TELEGRAM_ADMIN_ID=

# Second admin user ID (optional)
# TELEGRAM_ADMIN_ID_2=

# Optional password for non-admin users to authenticate
# BOT_ACCESS_PASSWORD=

# ─── LOCAL / DOCKER ──────────────────────────────────────────────────────────

# Set your local timezone so the scheduler fires at the right time.
# Examples: Europe/Vilnius, Europe/Prague, America/New_York, UTC
TZ=UTC

# Runtime environment. Use "production" in Docker for JSON logs.
NODE_ENV=production

# Log level: trace | debug | info | warn | error (default: info in prod, debug in dev)
# LOG_LEVEL=info

# ─── WEBHOOK / VERCEL (not needed for local Docker use) ──────────────────────
# Only required if you deploy the webhook handler to Vercel.
# WEBHOOK_SECRET=
